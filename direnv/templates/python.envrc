# Python Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Option 1: Standard venv (uncomment one)
# layout python3
# layout_python_venv .venv

# Option 2: Poetry (uncomment if using poetry)
# layout_poetry

# Option 3: Pipenv (uncomment if using pipenv)
# layout_pipenv

# Load .env file if it exists
dotenv_if_exists

# Set Python-specific options
env_default PYTHONDONTWRITEBYTECODE 1
env_default PYTHONUNBUFFERED 1

# Uncomment for Django projects
# env_default DJANGO_SETTINGS_MODULE myproject.settings.development

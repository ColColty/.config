# Go Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Set up Go paths
layout go

# Load .env file if it exists
dotenv_if_exists

# Common Go environment variables
env_default CGO_ENABLED 0
env_default GOPROXY "https://proxy.golang.org,direct"

# Uncomment for specific Go version (requires goenv or asdf)
# use_asdf golang 1.21.0

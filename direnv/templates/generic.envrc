# Generic Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Load .env file if it exists (most common use case)
dotenv_if_exists

# Or load a specific env file
# dotenv .env.local

# Add local bin directories to PATH
use_local_bin

# Set project-specific environment variables
# export PROJECT_NAME="my-project"
# export API_URL="http://localhost:3000"

# Require certain variables to be set
# require_env DATABASE_URL API_KEY

# Node.js Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Add node_modules/.bin to PATH
layout node

# Load .env file if it exists
dotenv_if_exists

# Use nvm if .nvmrc exists
use_nvm

# Set default environment
env_default NODE_ENV development

# Uncomment to set specific node options
# export NODE_OPTIONS="--max-old-space-size=4096"

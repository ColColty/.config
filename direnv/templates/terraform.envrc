# Terraform Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Load .env file if it exists (for TF_VARs)
dotenv_if_exists

# Set AWS profile for this project
# use_aws_profile my-project-profile

# Set Terraform workspace
# use_terraform_workspace development

# Common Terraform variables
env_default TF_CLI_ARGS_plan "-parallelism=30"
env_default TF_CLI_ARGS_apply "-parallelism=30"

# Disable Terraform telemetry
env_default CHECKPOINT_DISABLE 1

# Uncomment to set specific Terraform version (requires tfenv or asdf)
# use_asdf terraform 1.5.0

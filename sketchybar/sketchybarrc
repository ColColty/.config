#!/bin/bash
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="SF Pro"
export PLUGIN_DIR FONT

bar=(
  height=38
  color=$BAR_COLOR
  blur_radius=20
  shadow=off
  position=top
  sticky=on
  topmost=window
  padding_left=8
  padding_right=8
  notch_width=240
)
sketchybar --bar "${bar[@]}"

defaults=(
  updates=when_shown
  icon.font="$FONT:Semibold:13.0"
  icon.color=$ICON_COLOR
  icon.padding_left=8
  icon.padding_right=4
  label.font="$FONT:Medium:12.5"
  label.color=$LABEL_COLOR
  label.padding_left=2
  label.padding_right=8
  padding_left=3
  padding_right=3
  background.drawing=on
  background.color=$ITEM_BG_COLOR
  background.height=26
  background.corner_radius=8
  background.border_width=0
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.border_width=1
  popup.background.corner_radius=8
  popup.blur_radius=20
  popup.background.shadow.drawing=on
)
sketchybar --default "${defaults[@]}"

# Left: workspaces, then binding mode (hidden while in main)
source "$ITEM_DIR/omniwm.sh"
# source "$ITEM_DIR/mode.sh"   # AeroSpace binding modes; unused under OmniWM

# Notch gap tracks Alcove's width
source "$ITEM_DIR/notch.sh"

# Right edge: time, then status cluster
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/airpods.sh"
source "$ITEM_DIR/calendar.sh"
sketchybar --set clock padding_left=0 padding_right=0 \
           --set battery padding_left=0 padding_right=0 \
           --set wifi padding_left=0 padding_right=0 \
           --set airpods padding_left=0 padding_right=0
sketchybar --add bracket status clock battery wifi airpods calendar \
           --set status background.color=$ITEM_BG_COLOR background.corner_radius=8 background.height=26

sketchybar --hotload on
sketchybar --update
echo "sketchybar configuration loaded"

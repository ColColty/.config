# Kubernetes Project Environment
# Copy this to your project as .envrc and run: direnv allow

# Load .env file if it exists
dotenv_if_exists

# Set Kubernetes context and namespace
# use_kubectl my-cluster my-namespace

# Or just export the kubeconfig
# export KUBECONFIG="$PWD/kubeconfig.yaml"

# Set Helm namespace
# export HELM_NAMESPACE="my-namespace"

# Common kubectl options
env_default KUBECTL_EXTERNAL_DIFF "diff -u -N"
